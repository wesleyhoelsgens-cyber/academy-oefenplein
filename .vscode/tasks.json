{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Analyseer Inbox",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\inbox-workflow\\Invoke-InboxWorkflow.ps1",
                "-Mode",
                "Analyze"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
